    local playerStats = {}

    local function trackPlayer(player)
        if not playerStats[player.Name] then
            playerStats[player.Name] = { startTime = os.time(), joins = 0, leaves = 0 }
        end
    end

    for _, player in ipairs(Services.Players:GetPlayers()) do trackPlayer(player) end

    Services.Players.PlayerAdded:Connect(function(player)
        if playerStats[player.Name] then
            playerStats[player.Name].joins = playerStats[player.Name].joins + 1
            playerStats[player.Name].startTime = os.time()
        else 
            trackPlayer(player) 
        end
    end)

    Services.Players.PlayerRemoving:Connect(function(player)
        if playerStats[player.Name] then 
            playerStats[player.Name].leaves = playerStats[player.Name].leaves + 1 
        end
    end)

